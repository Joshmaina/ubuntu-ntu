# Copy to .env for local development. Never commit .env.
# These are LOCAL DEVELOPMENT credentials only — see docs/10-DEPENDENCIES.md.

# --- Postgres (container: ubuntuntu_postgres) ---
#
# NOTE the host port is 5433, not 5432.
#
# A natively installed PostgreSQL binds 5432 and wins the port; Docker's
# mapping then silently loses, and every client connects to the WRONG database.
# That presents as a confusing schema error ("relation already exists") rather
# than a connection error, so we avoid the well-known port entirely.
#
# If you have no native Postgres and prefer 5432, set POSTGRES_HOST_PORT=5432
# here and update DATABASE_URL to match.
POSTGRES_DB=ubuntuntu_dev
POSTGRES_USER=ubuntuntu_admin
POSTGRES_PASSWORD=ubuntuntu_local_dev
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5433
POSTGRES_PORT=5433

# NOTE the variable is UBUNTU_NTU_DATABASE_URL, not DATABASE_URL.
#
# A bare DATABASE_URL is the most commonly set variable in development, and a
# machine-wide one belonging to another project will silently hijack this one —
# connecting your migrations to someone else's database. The project-scoped
# name makes that impossible. Our tooling never reads bare DATABASE_URL.
UBUNTU_NTU_DATABASE_URL=postgresql://ubuntuntu_admin:ubuntuntu_local_dev@localhost:5433/ubuntuntu_dev

# --- Redis (container: ubuntuntu_redis) ---
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object storage (container: ubuntuntu_storage, MinIO / S3 API) ---
MINIO_ROOT_USER=ubuntuntu_admin
MINIO_ROOT_PASSWORD=ubuntuntu_local_dev
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ubuntuntu-audio

# --- Adapter selection (docs/05-ARCHITECTURE.md §10) ---
# Ports with a working free adapter today and a dormant paid one.
STORAGE_DRIVER=minio        # minio | s3
ASR_DRIVER=null             # null | hosted   (null throws NotConfiguredError)
NOTIFICATIONS_DRIVER=local  # local | fcm

# --- Auth ---
JWT_ACCESS_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_too_in_production
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
