# Copy to .env for local development. Never commit .env.
# These are LOCAL DEVELOPMENT credentials only — see docs/10-DEPENDENCIES.md.

# --- Postgres (container: ubuntuntu_postgres) ---
POSTGRES_DB=ubuntuntu_dev
POSTGRES_USER=ubuntuntu_admin
POSTGRES_PASSWORD=ubuntuntu_local_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ubuntuntu_admin:ubuntuntu_local_dev@localhost:5432/ubuntuntu_dev

# --- Redis (container: ubuntuntu_redis) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object storage (container: ubuntuntu_storage, MinIO / S3 API) ---
MINIO_ROOT_USER=ubuntuntu_admin
MINIO_ROOT_PASSWORD=ubuntuntu_local_dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ubuntuntu-audio

# --- Adapter selection (docs/05-ARCHITECTURE.md §10) ---
# Ports with a working free adapter today and a dormant paid one.
STORAGE_DRIVER=minio        # minio | s3
ASR_DRIVER=null             # null | hosted   (null throws NotConfiguredError)
NOTIFICATIONS_DRIVER=local  # local | fcm

# --- Auth ---
JWT_ACCESS_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_too_in_production
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
