{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // ADR-0002: core is runtime-agnostic. No "types": ["node"] here — pulling
    // in Node globals would make it possible to reference process/Buffer and
    // silently break the browser and React Native builds.
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**", "dist"]
}
