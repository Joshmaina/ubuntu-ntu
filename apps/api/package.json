{
  "name": "@ubuntu-ntu/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API: auth, content bundles, idempotent review-event ingestion.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run",
    "openapi": "tsx src/openapi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "^9.4.0",
    "@node-rs/argon2": "^2.0.2",
    "@ubuntu-ntu/config": "workspace:*",
    "@ubuntu-ntu/core": "workspace:*",
    "@ubuntu-ntu/schema": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
